# IPTV Portal Configuration
# Copy to .env and fill in your values

# 3DES encryption key (hex, 48 chars) — from APK decompilation
IPTV_3DES_KEY=

# API hosts (comma-separated, primary + fallback)
IPTV_HOSTS=osuhk.m3x8o50te.com,oogoy.f30c96w8.com

# Device fingerprint (only SN is required)
IPTV_DEVICE_SN=

# APK identity
IPTV_APP_ID=com.android.msandroid

# Optional device/APK fields (server accepts empty values)
IPTV_APK_VERSION=49902
IPTV_DEVICE_DRM_ID=
IPTV_DEVICE_TOKEN=
IPTV_DEVICE_RESERVE1=

# Login credentials (optional — leave empty for free tier)
IPTV_USERNAME=
IPTV_PASSWORD=

# Download settings
IPTV_DOWNLOAD_DIR=downloads

# Language (en or es — set from CLI on first run)
MAGIA_LANG=

# Telegram notifications (optional — configure from the CLI menu)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=0
